# Copy to .env and fill in. Never commit .env.
# REQUIRED: the trading-credit (sub) account's OWN API key (created inside that account), not the main account's key.
WALLEX_API_KEY=
# REQUIRED: trading-credit sub-account id, sent as `sub-account-client-id` on every private request.
# shadow/trade refuse to start without it.
WALLEX_SUBACCOUNT_ID=
BOXAPI_API_KEY=
WALLEXER_MODE=shadow
# Official (real) end of the challenge, UTC, ISO format. No new entries from T-90 min (18:50),
# force flatten from T-35 min (19:45).
WALLEXER_VIEW_TOKEN=
WALLEXER_REMOTE_URL=https://wallexer.liara.run

EVENT_END_UTC=2026-10-23T20:20:00Z
