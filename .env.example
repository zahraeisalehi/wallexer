# Copy to .env and fill in. Never commit .env.
# REQUIRED: the trading-credit (sub) account's OWN API key, not the main account's key.
WALLEX_API_KEY=
# REQUIRED: trading-credit sub-account id, sent as `sub-account-client-id` on every private request.
# shadow/trade refuse to start without it.
WALLEX_SUBACCOUNT_ID=
BOXAPI_API_KEY=
WALLEXER_MODE=shadow
# Official end of the challenge, UTC, ISO format. Drives the auto-flatten.
EVENT_END_UTC=2026-10-25T20:30:00Z
